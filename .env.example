# AI Code Audit - Environment Variables Example
# Copy this file to .env and fill in your API keys

# General API Key (works with any provider)
API_KEY=your-api-key-here

# Provider-specific API keys (optional)
# DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Default configuration
AUDIT_PROVIDER=deepseek
AUDIT_MODEL=deepseek-v4-flash
AUDIT_MAX_TOKENS=4096
AUDIT_TEMPERATURE=0.1

# Custom provider configuration
# CUSTOM_BASE_URL=https://your-custom-api.com
